# ClickLens Environment Configuration
#
# Copy this file to .env.local and fill in the values

# --- Primary: CLICKHOUSE_CLUSTERS (single or multi cluster) ---
# One entry for one ClickHouse cluster, more entries for more clusters.
# Uses the ClickHouse HTTP/HTTPS interface only (ports 8123/8443).
#
# Required fields: id, label, host, lensUser, lensPassword.
# Optional: port, secure, verifySsl, clickhouseCluster.
#
# Example (single cluster):
CLICKHOUSE_CLUSTERS='[
  {"id":"primary","label":"Primary","host":"localhost","port":8123,"lensUser":"lensuser","lensPassword":"change-me"}
]'
#
# Example (docker-compose with two independent CH nodes):
#   CLICKHOUSE_CLUSTERS='[
#     {"id":"ch1","label":"ClickHouse 01","host":"clickhouse-01","port":8123,"lensUser":"default","lensPassword":"password"},
#     {"id":"ch2","label":"ClickHouse 02","host":"clickhouse-02","port":8123,"lensUser":"default","lensPassword":"password"}
#   ]'
#
# NOTE: Docker init scripts run only on a new data volume.
# After changing demo users/passwords, reset volumes first:
#   docker compose -f docker-compose.multi-cluster.yml down -v
# Then restart:
#   docker compose -f docker-compose.multi-cluster.yml up --build

# --- Deprecated: Legacy single-cluster env vars ---
# CLICKHOUSE_HOST, CLICKHOUSE_PORT, CLICKHOUSE_SECURE, CLICKHOUSE_VERIFY,
# LENS_USER, and LENS_PASSWORD are deprecated and will be removed in the next
# major release. They are accepted temporarily when CLICKHOUSE_CLUSTERS is
# not set. Migrate to CLICKHOUSE_CLUSTERS above.
#
# Mapping:
#   CLICKHOUSE_HOST       -> host
#   CLICKHOUSE_PORT       -> port
#   CLICKHOUSE_SECURE     -> secure
#   CLICKHOUSE_VERIFY     -> verifySsl
#   LENS_USER             -> lensUser
#   LENS_PASSWORD         -> lensPassword

# Optional: explicitly set the ClickHouse cluster name.
# Use this when auto-detection is ambiguous, e.g. a real cluster and a Replicated
# database share the same name.
# CLICKHOUSE_CLUSTER=default

# Session Secret (required for production)
# Generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# Disable Secure Cookies for HTTP-only setups
# Set to 'true' if accessing ClickLens via HTTP (e.g. localhost, local network).
# DEFAULT: false (Secure cookies enforce HTTPS in production).
# DISABLE_SECURE_COOKIES=false

# Redis Configuration (optional)
# Used for query result caching. If not set, caching will be disabled.
# REDIS_URL=redis://localhost:6379

# Rate Limits (Requests per minute per IP/User)
RATE_LIMIT_GLOBAL=200
RATE_LIMIT_QUERY=120
RATE_LIMIT_LOGIN=10
RATE_LIMIT_KILL=20
