# ClickLens Environment Configuration
#
# Copy this file to .env.local and fill in the values

# --- Single-Cluster Mode (legacy) ---
# ClickHouse Server Connection (required in single-cluster mode)
# Uses HTTP interface (ports 8123/8443)
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_SECURE=false
# CLICKHOUSE_VERIFY=true
# LENS_USER=
# LENS_PASSWORD=

# --- Multi-Cluster Mode ---
# Uncomment CLICKHOUSE_CLUSTERS to override CLICKHOUSE_HOST/CLICKHOUSE_PORT/etc.
# Each entry requires: id, label, host, lensUser, lensPassword.
# Optional: port (default 8123 / 8443 for HTTPS), secure, verifySsl, clickhouseCluster.
#
# Example (docker-compose with two independent CH nodes):
#   CLICKHOUSE_CLUSTERS='[
#     {"id":"ch1","label":"ClickHouse 01","host":"clickhouse-01","port":8123,"lensUser":"default","lensPassword":"password"},
#     {"id":"ch2","label":"ClickHouse 02","host":"clickhouse-02","port":8123,"lensUser":"default","lensPassword":"password"}
#   ]'
#
# NOTE: The ClickHouse image only runs init scripts on a new data volume.
# After changing demo users/passwords, reset volumes first:
#   docker compose -f docker-compose.multi-cluster.yml down -v
# Then restart:
#   docker compose -f docker-compose.multi-cluster.yml up --build

# Lens Service User (for metadata queries)
# This user needs read access to system.* tables only
# Create with: CREATE USER lensuser IDENTIFIED BY 'password';
#              GRANT SELECT ON system.* TO lensuser;
# Note: In multi-cluster mode, each cluster's lensUser/lensPassword is defined
# in CLICKHOUSE_CLUSTERS and must have the same credentials across clusters.

# Optional: explicitly set the ClickHouse cluster name.
# Use this when auto-detection is ambiguous, e.g. a real cluster and a Replicated
# database share the same name.
# CLICKHOUSE_CLUSTER=default

# Session Secret (required for production)
# Generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# Disable Secure Cookies for HTTP-only setups
# Set to 'true' if accessing ClickLens via HTTP (e.g. localhost, local network).
# DEFAULT: false (Secure cookies enforce HTTPS in production).
# DISABLE_SECURE_COOKIES=false

# Redis Configuration (optional)
# Used for query result caching. If not set, caching will be disabled.
# REDIS_URL=redis://localhost:6379

# Rate Limits (Requests per minute per IP/User)
RATE_LIMIT_GLOBAL=200
RATE_LIMIT_QUERY=120
RATE_LIMIT_LOGIN=10
RATE_LIMIT_KILL=20
